{
  "expo": {
    "name": "AquiTemShabes",
    "slug": "aqtemshabes",
    "scheme": "aquitemshabes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo_AQUITEM.png",
    "userInterfaceStyle": "light",
    "notification": {
      "icon": "./assets/images/Logo_AQUITEM.png",
      "color": "#4F46E5",
      "iosDisplayInForeground": true
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquitem.aqtemshabes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.aquitem.aqtemshabes",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Logo_AQUITEM.png",
          "color": "#4F46E5"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9da9e350-2d9b-4f89-8f07-230444d95c0b"
      }
    }
  }
}